{
  "name": "api-pedidos",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de pedidos com Express e testes Jest.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "express": "^5.1.0" },
  "devDependencies": { "jest": "^30.2.0", "supertest": "^7.1.4" },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageThreshold": {
      "global": { "branches": 90, "functions": 95, "lines": 95, "statements": 95 }
    }
  }
}
