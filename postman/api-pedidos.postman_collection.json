{
  "info": {
    "name": "API de Pedidos - cenários de avaliação",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute em ordem com npm start ativo. Os cinco primeiros itens correspondem às evidências. Sem autenticação."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Criar pedido válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);",
              "pm.test('Status inicial', () => pm.expect(pm.response.json().status).to.eql('recebido'));",
              "pm.collectionVariables.set('pedidoId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Rejeitar cliente em branco",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);",
              "pm.test('Erro explicativo', () => pm.expect(pm.response.json().erro).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Listar pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/pedidos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);",
              "pm.test('Lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consultar inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/pedidos/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Cancelar pedido",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);",
              "pm.test('Cancelado', () => pm.expect(pm.response.json().status).to.eql('cancelado'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Consultar pedido existente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);",
              "pm.test('ID correto', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('pedidoId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Impedir reabertura",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"em_preparacao\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Status desconhecido",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"pronto\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Atualizar inexistente",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos/999999/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Repetir cancelamento",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Resposta JSON', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    }
  ]
}
